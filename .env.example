# Postgres local (docker-compose.yml, ADR 0005). Copie para .env e ajuste se precisar.
POSTGRES_DB=sdf_manager
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# URL de conexão usada pelo backend (SQLAlchemy assíncrono + psycopg v3, ADR 0005).
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/sdf_manager

# true: frontend usa dados mockados. false: frontend bate na API do backend.
VITE_USE_MOCK=true

# Figma MCP (token pessoal, usado para replicar telas do front). Nunca commitar o valor real.
FIGMA_API_TOKEN=
